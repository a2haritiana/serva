# serva configuration: sudo serva setup --yes --config serva.env
# Parsed, never executed: one SERVA_KEY=value per line, quotes optional.
# Keep it private (chmod 600) and delete it after use if it holds a hash.
# Commented keys use the default shown.

# Steps to run, space or comma separated. Default: all.
#SERVA_MODULES="user ssh firewall fail2ban updates swap sysctl cleanup"

# user: admin user name (required with --yes).
SERVA_USER=deploy
# Its sudo password as a crypt hash (required with --yes unless it has one):
#   openssl passwd -6
#SERVA_USER_PASSWORD_HASH='$6$salt$hash'
# Public key(s) to install, at least one source (serva never creates a private key):
#SERVA_PUBKEY="ssh-ed25519 AAAAC3Nza... you@laptop"
#SERVA_PUBKEY_GITHUB=your-github-name
#SERVA_PUBKEY_FROM_ROOT=no

# ssh: seconds to confirm a new login before the automatic rollback (30-900).
#SERVA_SSH_CONFIRM_TIMEOUT=120

# firewall: open ports 80 and 443 (yes/no).
#SERVA_OPEN_WEB=yes

# fail2ban: addresses or ranges never banned, or none.
#SERVA_F2B_IGNOREIP=none

# updates: upgrade now (yes/no), automatic reboot (yes/no) and its time (HH:MM).
#SERVA_UPGRADE_NOW=yes
#SERVA_AUTO_REBOOT=no
#SERVA_AUTO_REBOOT_TIME=04:00

# swap: size such as 2G or 1536M, 0 to skip. Default: 2G, 4G above 8 GB of RAM.
#SERVA_SWAP_SIZE=2G

# cleanup (with --yes, nothing happens unless set): provider accounts (ubuntu, debian...)
# lock|keep, /root/.ssh/authorized_keys remove|keep, root password yes|no.
#SERVA_CLEANUP_USERS=keep
#SERVA_CLEANUP_ROOT_KEYS=keep
#SERVA_LOCK_ROOT=no

# Try serva on an untested system (yes/no).
#SERVA_FORCE_OS=no
